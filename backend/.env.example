# ===== 智聘云图环境变量配置示例 =====
# 复制此文件为 .env.dev (开发) 或 .env.prod (生产) 并修改对应值

# ===== 应用配置 =====
APP_ENV=development                    # development | production
APP_DEBUG=true                         # 生产环境设为 false
APP_NAME=智聘云图
APP_VERSION=1.0.0
SECRET_KEY=please-change-this-to-random-string

# ===== 后端服务 =====
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ===== 数据库 =====
# 开发环境: SQLite (零配置)
# 生产环境: 推荐达梦 DM8 (LoongArch 国产化要求)
#   DM8 URL 示例: dm+dmPython://zhipin:zhipin123@dm8:5236/zhipin
DATABASE_URL=sqlite:///./zhipin.db

# ===== Redis =====
REDIS_URL=redis://localhost:6379/0

# ===== Neo4j 知识图谱 =====
# 程序内置降级机制, Neo4j 不可用时自动从关系数据库构建图谱
NEO4J_URL=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=zhipin123

# ===== 文件存储 =====
STORAGE_TYPE=local                     # local | oss (预留)
STORAGE_PATH=./uploads

# ===== 豆包 ARK API =====
# 申请地址: https://console.volcengine.com/ark
ARK_API_KEY=your-ark-api-key-here
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_CHAT_MODEL=doubao-seed-2-0-lite-260428
ARK_EMBEDDING_MODEL=doubao-embedding-text-240915

# ===== Celery (异步任务) =====
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ===== JWT 认证 =====
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120    # Access Token 有效期 2 小时
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7        # Refresh Token 有效期 7 天
JWT_ALGORITHM=HS256

# ===== CORS =====
# 逗号分隔的前端来源地址
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
