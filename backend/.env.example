# ===== 智聘云图环境变量配置示例 =====
# 复制此文件为 .env.dev (开发) 或 .env.prod (生产) 并修改对应值

# ===== 应用配置 =====
APP_ENV=development                    # development | production
APP_DEBUG=true                         # 生产环境设为 false
APP_NAME=智聘云图
APP_VERSION=1.0.0
SECRET_KEY=please-change-this-to-random-string

# ===== 后端服务 =====
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ===== 数据库 =====
# 开发/生产环境: GreatSQL 8.0 (兼容 MySQL 协议, 国产化合规)
#   GreatSQL URL 示例: mysql+pymysql://root:123456@127.0.0.1:3306/zhipin?charset=utf8mb4
DATABASE_URL=mysql+pymysql://root:123456@127.0.0.1:3306/zhipin?charset=utf8mb4

# ===== Redis =====
REDIS_URL=redis://localhost:6379/0

# ===== NebulaGraph 图数据库 =====
# 程序内置降级机制, NebulaGraph 不可用时自动从关系数据库构建图谱
# 首次使用需创建空间: CREATE SPACE IF NOT EXISTS zhipin(partition_num=1, replica_factor=1, vid_type=FIXED_STRING(64));
NEBULA_HOST=127.0.0.1
NEBULA_PORT=9669
NEBULA_USER=root
NEBULA_PASSWORD=nebula
NEBULA_SPACE=zhipin

# ===== 文件存储 =====
STORAGE_TYPE=local                     # local | oss (预留)
STORAGE_PATH=./uploads

# ===== 豆包 ARK API =====
# 申请地址: https://console.volcengine.com/ark
ARK_API_KEY=your-ark-api-key-here
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_CHAT_MODEL=doubao-seed-2-0-lite-260428
ARK_EMBEDDING_MODEL=doubao-embedding-text-240915

# ===== Celery (异步任务) =====
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ===== JWT 认证 =====
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120    # Access Token 有效期 2 小时
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7        # Refresh Token 有效期 7 天
JWT_ALGORITHM=HS256

# ===== CORS =====
# 逗号分隔的前端来源地址
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
